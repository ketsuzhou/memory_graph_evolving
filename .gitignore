# 编译产物 / build artifacts
# Anchored to the exact built-binary paths: bare names ("server",
# "bench-runner") also match cmd/<name>/ source directories and would
# untrack them.
graph-memory-service/server
pi-group-chat-host/bench-runner
pi-group-chat-host/past-runner
*.exe
*.test
*.out

# 运行输出 / runtime outputs
outputs/

# 本地配置 / local config
.kiro/

# 系统文件 / OS files
.DS_Store

# 编译生成的 driver / conformance 二进制
graph-memory-service/contract-conformance
graph-memory-service/s2s4-driver
graph-memory-service/s5s9-driver
pi-group-chat-host/s2s4-driver
__pycache__/
*.pyc
.pytest_cache/
