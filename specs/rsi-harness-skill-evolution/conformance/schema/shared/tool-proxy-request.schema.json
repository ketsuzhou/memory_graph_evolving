{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rsih-skill-evolution.shared.tool-proxy-request.v1.schema.json",
  "title": "Contract 7.17 ToolProxyRequest",
  "description": "Freshness/authorization ride on request fields + authoritative read audit (12.7.1 M4/M5), never on the closed result DTO.",
  "contract_refs": [
    "system-contract.md 7.17"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proxy_request_id",
    "room_id",
    "agent_id",
    "delivery_id",
    "tool_name",
    "arguments",
    "scope_profile_ref",
    "idempotency_key",
    "timeout_millis"
  ],
  "properties": {
    "schema_version": {
      "const": "host.tool-proxy-request.v1"
    },
    "proxy_request_id": {
      "$ref": "common-types.schema.json#/$defs/non_empty_string"
    },
    "room_id": {
      "$ref": "common-types.schema.json#/$defs/non_empty_string"
    },
    "agent_id": {
      "$ref": "common-types.schema.json#/$defs/non_empty_string"
    },
    "delivery_id": {
      "$ref": "common-types.schema.json#/$defs/non_empty_string"
    },
    "tool_name": {
      "enum": [
        "memory_explore",
        "memory_expand",
        "skill_get"
      ]
    },
    "arguments": {
      "type": "object"
    },
    "scope_profile_ref": {
      "$ref": "common-types.schema.json#/$defs/versioned_ref"
    },
    "idempotency_key": {
      "$ref": "common-types.schema.json#/$defs/sha256"
    },
    "requested_min_activation_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timeout_millis": {
      "type": "integer",
      "minimum": 1
    }
  }
}
