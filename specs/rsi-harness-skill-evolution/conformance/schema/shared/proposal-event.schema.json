{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rsih-skill-evolution.shared.proposal-event.v1.schema.json",
  "title": "Ordinary SkillProposalEvent (CTR-005 gap fill for Contract 9.1)",
  "description": "CTR-005 freezes the ordinary (non-merge) proposal state event that Contract 9.1 left without a DTO: states advance only via protected CAS appends of this event; terminal states never reopen; every transition MUST be an edge of schema/state/proposal-lifecycle.schema.json (ILLEGAL_STATE_TRANSITION otherwise).",
  "contract_refs": [
    "system-contract.md 9.1",
    "system-contract.md 7.23"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_ref",
    "event_sequence",
    "event_id",
    "event_digest",
    "from_state",
    "to_state",
    "reason_codes",
    "authority_ref",
    "record_refs",
    "payload_digest",
    "expected_previous_event_sequence"
  ],
  "properties": {
    "schema_version": {
      "const": "gms.proposal-event.v1"
    },
    "proposal_ref": {
      "$ref": "common-types.schema.json#/$defs/versioned_ref"
    },
    "event_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "$ref": "common-types.schema.json#/$defs/non_empty_string"
    },
    "event_digest": {
      "$ref": "common-types.schema.json#/$defs/sha256"
    },
    "from_state": {
      "enum": [
        "none",
        "proposed",
        "admitted",
        "candidate_bound",
        "validating",
        "replay_pending",
        "replaying",
        "decision_pending",
        "activation_pending"
      ]
    },
    "to_state": {
      "enum": [
        "proposed",
        "admitted",
        "candidate_bound",
        "validating",
        "replay_pending",
        "replaying",
        "decision_pending",
        "activation_pending",
        "released",
        "rejected",
        "inconclusive",
        "stale",
        "withdrawn"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "$ref": "common-types.schema.json#/$defs/non_empty_string"
      },
      "minItems": 0
    },
    "authority_ref": {
      "$ref": "common-types.schema.json#/$defs/versioned_ref"
    },
    "record_refs": {
      "type": "array",
      "items": {
        "$ref": "common-types.schema.json#/$defs/versioned_ref"
      },
      "minItems": 0
    },
    "observed_target_head": {
      "$ref": "skill-artifact-ref.schema.json#"
    },
    "payload_digest": {
      "$ref": "common-types.schema.json#/$defs/sha256"
    },
    "expected_previous_event_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "extensions": {
      "$ref": "common-types.schema.json#/$defs/extensions"
    }
  },
  "x-digest": {
    "digest_field": "event_digest",
    "algorithm": "sha256-over-jcs",
    "preimage_fields": [
      "schema_version",
      "proposal_ref",
      "event_sequence",
      "event_id",
      "from_state",
      "to_state",
      "reason_codes",
      "authority_ref",
      "record_refs",
      "payload_digest",
      "expected_previous_event_sequence"
    ],
    "preimage_rule": "event_digest = SHA-256(JCS(core minus event_digest and extensions))."
  }
}
