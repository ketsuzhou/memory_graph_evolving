{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rsih-skill-evolution.shared.validation-contract.v1.schema.json",
  "title": "Arm C Validation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "version", "contract_digest", "task_family", "allowed_commands", "required_artifact_invariants", "resource_limits", "success_signals", "failure_signals"],
  "properties": {
    "schema_version": {"const": "gms.validation-contract.v1"},
    "contract_id": {"$ref": "common-types.schema.json#/$defs/non_empty_string"},
    "version": {"type": "integer", "minimum": 1},
    "contract_digest": {"$ref": "common-types.schema.json#/$defs/sha256"},
    "task_family": {"$ref": "common-types.schema.json#/$defs/non_empty_string"},
    "allowed_commands": {"type": "array", "minItems": 1, "items": {"$ref": "common-types.schema.json#/$defs/non_empty_string"}},
    "required_artifact_invariants": {"type": "array", "items": {"$ref": "common-types.schema.json#/$defs/non_empty_string"}},
    "resource_limits": {"type": "object", "additionalProperties": false, "required": ["max_commands", "max_cpu_units", "max_memory_bytes", "max_duration_millis"], "properties": {"max_commands": {"type": "integer", "minimum": 1}, "max_cpu_units": {"type": "integer", "minimum": 1}, "max_memory_bytes": {"type": "integer", "minimum": 1}, "max_duration_millis": {"type": "integer", "minimum": 1}}},
    "success_signals": {"type": "array", "items": {"$ref": "common-types.schema.json#/$defs/non_empty_string"}},
    "failure_signals": {"type": "array", "items": {"$ref": "common-types.schema.json#/$defs/non_empty_string"}}
  },
  "x-digest": {"digest_field": "contract_digest", "algorithm": "sha256-over-jcs", "preimage_fields": ["schema_version", "contract_id", "version", "task_family", "allowed_commands", "required_artifact_invariants", "resource_limits", "success_signals", "failure_signals"]}
}
