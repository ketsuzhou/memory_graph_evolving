{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rsih-skill-evolution.shared.skill-artifact-envelope.v2.schema.json",
  "title": "Contract 8.1 canonical artifact envelope v2",
  "description": "V2 is the sole canonical artifact envelope; v1 has no compatibility path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "description", "applicability", "permissions", "body"],
  "properties": {
    "schema_version": {"const": "gms.skill-artifact.v2"},
    "kind": {"$ref": "common-types.schema.json#/$defs/canonical_kind"},
    "title": {"$ref": "common-types.schema.json#/$defs/non_empty_string"},
    "description": {"type": "string"},
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["predicates", "exclusions"],
      "properties": {
        "predicates": {"type": "array", "items": {"$ref": "common-types.schema.json#/$defs/predicate"}, "minItems": 0},
        "exclusions": {"type": "array", "items": {"$ref": "common-types.schema.json#/$defs/predicate"}, "minItems": 0}
      }
    },
    "permissions": {"type": "array", "items": {"$ref": "common-types.schema.json#/$defs/permission"}, "minItems": 0},
    "body": {"type": "object"},
    "extensions": {"$ref": "common-types.schema.json#/$defs/extensions"}
  }
}
