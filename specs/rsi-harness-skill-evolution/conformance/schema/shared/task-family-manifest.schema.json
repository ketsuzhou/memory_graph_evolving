{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rsih-skill-evolution.shared.task-family-manifest.v1.schema.json",
  "title": "Arm C Task Family Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "version", "manifest_digest", "task_family", "validation_contract_ref"],
  "properties": {
    "schema_version": {"const": "gms.task-family-manifest.v1"},
    "manifest_id": {"$ref": "common-types.schema.json#/$defs/non_empty_string"},
    "version": {"type": "integer", "minimum": 1},
    "manifest_digest": {"$ref": "common-types.schema.json#/$defs/sha256"},
    "task_family": {"$ref": "common-types.schema.json#/$defs/non_empty_string"},
    "validation_contract_ref": {"type": "object", "additionalProperties": false, "required": ["contract_id", "version", "digest"], "properties": {"contract_id": {"$ref": "common-types.schema.json#/$defs/non_empty_string"}, "version": {"type": "integer", "minimum": 1}, "digest": {"$ref": "common-types.schema.json#/$defs/sha256"}}}
  },
  "x-digest": {"digest_field": "manifest_digest", "algorithm": "sha256-over-jcs", "preimage_fields": ["schema_version", "manifest_id", "version", "task_family", "validation_contract_ref"]}
}
