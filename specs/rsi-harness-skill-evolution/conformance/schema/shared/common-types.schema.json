{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rsih-skill-evolution.shared.common-types.v2.schema.json",
  "title": "Contract 7.2 common value types",
  "description": "Shared v2 value types and the closed Tool Skill capable canonical kind set.",
  "contract_refs": ["system-contract.md 7.2", "system-contract.md 5.2", "system-contract.md 13.3", "system-contract.md 6.4"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "non_empty_string": {"type": "string", "minLength": 1},
    "versioned_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"$ref": "common-types.schema.json#/$defs/non_empty_string"},
        "version": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "common-types.schema.json#/$defs/sha256"}
      }
    },
    "rational": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 1}}
    },
    "json_schema_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "version", "digest"],
      "properties": {
        "schema_id": {"$ref": "common-types.schema.json#/$defs/non_empty_string"},
        "version": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "common-types.schema.json#/$defs/sha256"}
      }
    },
    "extensions": {"type": "object"},
    "canonical_kind": {
      "enum": ["human_procedure", "step_guidance", "composite", "tool"],
      "description": "Contract 5.2.1 v2 closed canonical kind set."
    },
    "failure_action": {"enum": ["stop", "skip", "fallback", "request_human", "mark_inconclusive"]},
    "permission": {
      "type": "object", "additionalProperties": false,
      "required": ["capability", "scope"],
      "properties": {
        "capability": {"$ref": "common-types.schema.json#/$defs/non_empty_string"},
        "scope": {"$ref": "common-types.schema.json#/$defs/non_empty_string"}
      }
    },
    "predicate": {"type": "object"}
  }
}
