{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://river2.dev/schemas/benchmark-diagnosis-replay-export/diagnosis_capability.schema.json",
  "title": "DiagnosisCapability",
  "description": "SC-1.2/SC-1.3/SC-6.1 (Q53=A/Q68/Q70): short-lived, read-only, cut-scoped capability proving exactly which Room-bound private Spaces one Diagnosis execution may read, with audit-chain binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "tenant_id",
    "cut_id",
    "principal_id",
    "bound_private_spaces",
    "operations",
    "expires_at",
    "read_audit_chain_digest"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "cut_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_run_id": {
      "type": "string",
      "minLength": 1
    },
    "bound_private_spaces": {
      "description": "Exactly the private Spaces bound to the Room at freeze; scope check against the frozen Cut is rule capability_scope_within_cut.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "space_id",
          "room_id",
          "room_epoch"
        ],
        "properties": {
          "space_id": {
            "type": "string",
            "minLength": 1
          },
          "room_id": {
            "type": "string",
            "minLength": 1
          },
          "room_epoch": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "operations": {
      "description": "Q70: read-only. Any non-read operation is rejected at schema level.",
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "read"
        ]
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "read_audit_chain_digest": {
      "description": "Q70/Q94: digest binding this capability to the append-only private-read audit chain.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
