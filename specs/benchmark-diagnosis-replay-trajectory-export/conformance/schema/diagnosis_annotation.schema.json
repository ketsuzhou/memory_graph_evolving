{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://river2.dev/schemas/benchmark-diagnosis-replay-export/diagnosis_annotation.schema.json",
  "title": "DiagnosisAnnotation",
  "description": "SC-6.2 (Q46/Q54/Q55/Q76/Q93): one immutable Diagnosis annotation revision bound to the exact call or assistant turn. Raw annotations never propagate along edges; higher-level scores are derived by versioned aggregation policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotation_id",
    "revision",
    "cut_id",
    "tenant_id",
    "target",
    "status",
    "diagnosis_policy_revision",
    "execution_recipe_digest"
  ],
  "properties": {
    "annotation_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_revision": {
      "type": "integer",
      "minimum": 1
    },
    "cut_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "$ref": "#/$defs/annotationTarget"
    },
    "status": {
      "enum": [
        "verified",
        "failed",
        "inconclusive",
        "missing"
      ]
    },
    "reward_status": {
      "enum": [
        "rewarded",
        "masked_missing",
        "masked_inconclusive"
      ]
    },
    "evidence_citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "disclosure_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnosis_policy_revision": {
      "type": "string",
      "minLength": 1
    },
    "execution_recipe_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_by_agent_run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "annotationTarget": {
      "description": "SC-6.2: exact-node binding; exactly one of {segment_id, call_id} or {segment_id, assistant_turn_seq}.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "segment_id",
            "call_id"
          ],
          "properties": {
            "segment_id": {
              "type": "string",
              "minLength": 1
            },
            "call_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "segment_id",
            "assistant_turn_seq"
          ],
          "properties": {
            "segment_id": {
              "type": "string",
              "minLength": 1
            },
            "assistant_turn_seq": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "event_ids"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "space_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "version_note": "v2: annotationTarget is a closed oneOf (call-bound | turn-bound), exactly one binding (SC-6.2, kiro review P2-1)."
}
